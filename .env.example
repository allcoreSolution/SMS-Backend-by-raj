# ==============================================================
# SCHOOL ERP API - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================
# Copy this file to '.env' and customize values for your environment.

# Server & Network Configuration
PORT=5050
NODE_ENV=development
CORS_ORIGIN=*

# MongoDB Database Connection
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/school_erp
# MongoDB Atlas (Cloud Cluster):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/school_erp?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here_School_ERP_2026
JWT_EXPIRES_IN=30d

# Email / Gmail SMTP Configuration
EMAIL_ENABLED=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="School ERP <your_email@gmail.com>"

# Meta WhatsApp Cloud API (Official Business API)
META_WHATSAPP_TOKEN=your_meta_system_user_permanent_access_token
META_PHONE_NUMBER_ID=your_meta_phone_number_id
META_WABA_ID=your_meta_whatsapp_business_account_id
META_API_VERSION=v20.0
META_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verification_token

# Twilio SMS Gateway Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Razorpay Payment Gateway (Optional)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Frontend Client URL (For password reset redirects and emails)
CLIENT_URL=http://localhost:5177
