# ==============================================================
# SCHOOL ERP API - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================

PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/school_erp
JWT_SECRET=your_jwt_secret_here_School-ERP
JWT_EXPIRES_IN=30d
NODE_ENV=development
CORS_ORIGIN=*

# ==============================================================
# META WHATSAPP CLOUD API CONFIGURATION (OFFICIAL)
# Obtain from: https://developers.facebook.com -> Your App -> WhatsApp -> API Setup
# ==============================================================

# Meta Permanent Access Token from System User (or 24h temporary test token)
META_WHATSAPP_TOKEN=your_meta_system_user_permanent_access_token_here

# Meta WhatsApp Phone Number ID (From API Setup section)
META_PHONE_NUMBER_ID=your_meta_phone_number_id_here

# Meta WhatsApp Business Account ID (WABA ID)
META_WABA_ID=your_meta_whatsapp_business_account_id_here

# Meta Graph API Version (e.g. v20.0 or v19.0)
META_API_VERSION=v20.0

# Meta Webhook Verification Secret Token (Must match token set in Meta Dashboard)
META_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verification_token_here
